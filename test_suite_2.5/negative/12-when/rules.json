{
    "contact_none": {
        "nested_object": {
            "email": {"when": ["phone", "not_empty", "email", ["required", "email"]]},
            "phone": {"when": ["email", "not_empty", "string", ["required", "string"]]}
        }
    },
    "contact_bad_email": {
        "nested_object": {
            "email": {"when": ["phone", "not_empty", "email", ["required", "email"]]},
            "phone": {"when": ["email", "not_empty", "string", ["required", "string"]]}
        }
    },
    "contact_empty_values": {
        "nested_object": {
            "email": {"when": ["phone", "not_empty", "email", ["required", "email"]]},
            "phone": {"when": ["email", "not_empty", "string", ["required", "string"]]}
        }
    },
    "customer_type": "string",
    "vat_missing": {
        "when": [
            "customer_type",
            {"eq": "company"},
            ["required", {"like": "^[A-Z]{2}[0-9]{8,12}$"}],
            {"eq": ""}
        ]
    },
    "vat_bad": {
        "when": [
            "customer_type",
            {"eq": "company"},
            ["required", {"like": "^[A-Z]{2}[0-9]{8,12}$"}],
            {"eq": ""}
        ]
    },
    "person_type": "string",
    "person_vat": {
        "when": ["person_type", {"eq": "company"}, ["required", {"like": "^[A-Z]{2}[0-9]{8,12}$"}], {"eq": ""}]
    },
    "person_vat_zero": {
        "when": ["person_type", {"eq": "company"}, ["required", {"like": "^[A-Z]{2}[0-9]{8,12}$"}], {"eq": ""}]
    },
    "missing_type_vat": {
        "when": [
            "no_such_field",
            {"eq": "company"},
            ["required", {"like": "^[A-Z]{2}[0-9]{8,12}$"}],
            {"eq": ""}
        ]
    },
    "email_subscribe": ["email", {"when": ["subscribe", ["boolean", {"eq": true}], "required"]}],
    "email_subscribe_bad": ["email", {"when": ["subscribe", ["boolean", {"eq": true}], "required"]}],
    "email_subscribe_true": ["email", {"when": ["subscribe_true", ["boolean", {"eq": true}], "required"]}],
    "email_subscribe_true_string": [
        "email",
        {"when": ["subscribe_true_string", ["boolean", {"eq": true}], "required"]}
    ],
    "pipe_false": {"when": ["flag_zero", ["boolean", {"eq": true}], "to_uc", "required"]},
    "cond_empty_ref": {"when": ["empty_ref", "string", "to_uc", "required"]},
    "cond_missing_ref": {"when": ["no_such_field", "string", "to_uc", "required"]},
    "cond_true_error": {"when": ["mode_num", {"eq": "num"}, "positive_integer", "email"]},
    "cond_false_error": {"when": ["mode_other", {"eq": "num"}, "positive_integer", "email"]},
    "zip": {"when": ["address/country", {"eq": "UA"}, ["required", "digits"], {"eq": ""}]},
    "zip_bad": {"when": ["address/country", {"eq": "UA"}, ["required", "digits"], {"eq": ""}]},
    "zip_us": {"when": ["address_us/country", {"eq": "UA"}, ["required", "digits"], {"eq": ""}]},
    "data_cash": [
