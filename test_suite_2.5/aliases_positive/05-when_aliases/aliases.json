[
    {
        "name": "vat_by_type",
        "rules": { "when": ["type", { "eq": "company" },
            ["required", { "like": "^[A-Z]{2}[0-9]{8,12}$" }], { "eq": "" }] }
    },
    {
        "name": "case_by_mode",
        "rules": { "when": ["mode", { "eq": "upper" }, "to_uc", "to_lc"] }
    },
    {
        "name": "payment_data",
        "rules": { "when": ["pay_type", {
            "card": { "nested_object": { "number": ["required", "credit_card"] } },
            "bank": { "nested_object": { "iban": ["required", "iban"] } }
        }] }
    },
    {
        "name": "required_payment_data",
        "rules": ["required", "payment_data"]
    }
]
